{
  "name": "indian-pincode-utils",
  "version": "1.1.0",
  "description": "Fast Indian pincode lookup with geospatial utilities",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "types": "./dist/cjs/index.d.ts"
    },
    "./mcp": {
      "require": "./dist/cjs/mcp.js",
      "import": "./dist/esm/mcp.js",
      "types": "./dist/cjs/mcp.d.ts"
    },
    "./autocomplete": {
      "require": "./dist/cjs/autocomplete.js",
      "import": "./dist/esm/autocomplete.js",
      "types": "./dist/cjs/autocomplete.d.ts"
    },
    "./shipping": {
      "require": "./dist/cjs/shipping.js",
      "import": "./dist/esm/shipping.js",
      "types": "./dist/cjs/shipping.d.ts"
    },
    "./validation": {
      "require": "./dist/cjs/validation.js",
      "import": "./dist/esm/validation.js",
      "types": "./dist/cjs/validation.d.ts"
    },
    "./gst": {
      "require": "./dist/cjs/gst.js",
      "import": "./dist/esm/gst.js",
      "types": "./dist/cjs/gst.d.ts"
    }
  },
  "bin": {
    "pincode-mcp": "./bin/pincode-mcp.js"
  },
  "files": [
    "dist",
    "data",
    "bin"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prasoon007/indian-pincode-utils.git"
  },
  "bugs": {
    "url": "https://github.com/prasoon007/indian-pincode-utils/issues"
  },
  "homepage": "https://github.com/prasoon007/indian-pincode-utils#readme",
  "author": "prasoon007",
  "keywords": [
    "pincode",
    "india",
    "indian-pincode",
    "postal-code",
    "pin-code",
    "india-post",
    "geo",
    "geolocation",
    "distance",
    "logistics",
    "delivery",
    "zipcode-india",
    "postal-data",
    "gst",
    "gst-state-code",
    "address-validation",
    "address-autofill",
    "city-tier",
    "shipping-zone",
    "delivery-estimate",
    "courier",
    "ecommerce",
    "serviceability",
    "autocomplete",
    "mcp",
    "model-context-protocol",
    "ai-tools",
    "llm-tools"
  ],
  "license": "MIT",
  "scripts": {
    "generate:data": "node ./scripts/csv-to-json.js",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:fix-esm": "node ./scripts/fix-esm-imports.js",
    "build:copy-data": "node -e \"const fs=require('fs');fs.rmSync('dist/data',{recursive:true,force:true});fs.cpSync('data','dist/data',{recursive:true});\"",
    "build": "npm run build:cjs && npm run build:esm && npm run build:fix-esm && npm run build:copy-data",
    "test": "node ./scripts/smoke-test.js",
    "benchmark": "node ./scripts/benchmark.js"
  },
  "dependencies": {
    "ngeohash": "^0.6.3"
  },
  "devDependencies": {
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^20.11.0",
    "csv-parser": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
